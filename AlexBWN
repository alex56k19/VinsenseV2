local HOP_HISTORY_FILE = CONFIG_FOLDER .. "/ServerHistory.json"

-- V6 ULTRA-SCALE
-- Tuned for very high-CCU experiences where public server lists change constantly.
local HOP_MAX_PAGES = 3
local HOP_REQUEST_RETRIES = 5
local RECENT_SERVER_TTL = 240
local FAILED_SERVER_TTL = 900
local HOP_RETRY_DELAY = 0.70
local TELEPORT_WATCHDOG_SECONDS = 12
local MAX_HISTORY_ENTRIES = 500

local recentServerTimes = {}
local failedServerTimes = {}
local hopHistoryLoaded = false

local activeCandidates = {}
local activeCandidateIndex = 1
local pendingServerId = nil
local pendingAttemptId = 0
local hopRetryQueued = false
local scanningServers = false

local function currentUnixTime()
    local success, value = pcall(function()
        return os.time()
    end)

    if success and type(value) == "number" then
        return value
    end

    return 0
end

local function tableEntryCount(map)
    local count = 0
    for _ in pairs(map) do
        count = count + 1
    end
    return count
end

local function trimHistoryMap(map, maxEntries)
    local count = tableEntryCount(map)
    if count <= maxEntries then
        return
    end

    local entries = {}
    for serverId, timestamp in pairs(map) do
        table.insert(entries, {
            Id = serverId,
            Time = tonumber(timestamp) or 0
        })
    end

    table.sort(entries, function(a, b)
        return a.Time < b.Time
    end)

    local removeCount = count - maxEntries
    for index = 1, removeCount do
        map[entries[index].Id] = nil
    end
end

local function pruneServerHistory()
    local now = currentUnixTime()

    for serverId, timestamp in pairs(recentServerTimes) do
        if type(timestamp) ~= "number" or now - timestamp > RECENT_SERVER_TTL then
            recentServerTimes[serverId] = nil
        end
    end

    for serverId, timestamp in pairs(failedServerTimes) do
        if type(timestamp) ~= "number" or now - timestamp > FAILED_SERVER_TTL then
            failedServerTimes[serverId] = nil
        end
    end

    recentServerTimes[game.JobId] = now
    visitedServers[game.JobId] = true

    trimHistoryMap(recentServerTimes, MAX_HISTORY_ENTRIES)
    trimHistoryMap(failedServerTimes, MAX_HISTORY_ENTRIES)
end

local function saveServerHistory()
    if not FILES_SUPPORTED then
        return
    end

    pruneServerHistory()

    pcall(function()
        if not isfolder(CONFIG_FOLDER) then
            makefolder(CONFIG_FOLDER)
        end

        writefile(HOP_HISTORY_FILE, HttpService:JSONEncode({
            PlaceId = PLACE_ID,
            Recent = recentServerTimes,
            Failed = failedServerTimes
        }))
    end)
end

local function loadServerHistory()
    if hopHistoryLoaded then
        return
    end

    hopHistoryLoaded = true

    if FILES_SUPPORTED and isfile(HOP_HISTORY_FILE) then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(HOP_HISTORY_FILE))
        end)

        if success and type(data) == "table" and tonumber(data.PlaceId) == PLACE_ID then
            if type(data.Recent) == "table" then
                for serverId, timestamp in pairs(data.Recent) do
                    if type(serverId) == "string" and type(timestamp) == "number" then
                        recentServerTimes[serverId] = timestamp
                    end
                end
            end

            if type(data.Failed) == "table" then
                for serverId, timestamp in pairs(data.Failed) do
                    if type(serverId) == "string" and type(timestamp) == "number" then
                        failedServerTimes[serverId] = timestamp
                    end
                end
            end
        end
    end

    pruneServerHistory()

    for serverId in pairs(recentServerTimes) do
        visitedServers[serverId] = true
    end
end

local function markServerRecent(serverId)
    if type(serverId) ~= "string" or serverId == "" then
        return
    end

    recentServerTimes[serverId] = currentUnixTime()
    visitedServers[serverId] = true
end

local function markServerFailed(serverId)
    if type(serverId) ~= "string" or serverId == "" then
        return
    end

    local now = currentUnixTime()
    failedServerTimes[serverId] = now
    recentServerTimes[serverId] = now
    visitedServers[serverId] = true
    saveServerHistory()
end

local function isRecentServer(serverId)
    local timestamp = recentServerTimes[serverId]
    if type(timestamp) ~= "number" then
        return false
    end

    return currentUnixTime() - timestamp <= RECENT_SERVER_TTL
end

local function isFailedServer(serverId)
    local timestamp = failedServerTimes[serverId]
    if type(timestamp) ~= "number" then
        return false
    end

    return currentUnixTime() - timestamp <= FAILED_SERVER_TTL
end

local function getRetryAfterSeconds(response)
    if not response or type(response.Headers) ~= "table" then
        return nil
    end

    local value = response.Headers["retry-after"]
        or response.Headers["Retry-After"]
        or response.Headers["RETRY-AFTER"]

    local seconds = tonumber(value)
    if seconds and seconds >= 0 then
        return math.min(seconds, 8)
    end

    return nil
end

local function fetchHopServers(req, cursor)
    local url = "https://games.roblox.com/v1/games/" .. tostring(PLACE_ID)
        .. "/servers/Public?excludeFullGames=true&limit=100"

    if cursor and cursor ~= "" then
        url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
    end

    for attempt = 1, HOP_REQUEST_RETRIES do
        if not alive then
            return nil, "stopped"
        end

        local requestSuccess, response = pcall(function()
            return req({
                Url = url,
                Method = "GET"
            })
        end)

        if requestSuccess and response then
            local statusCode = tonumber(response.StatusCode or response.Status)
            local body = response.Body

            if (statusCode == nil or (statusCode >= 200 and statusCode < 300))
                and body and body ~= "" and body ~= "null" then

                local decodeSuccess, data = pcall(function()
                    return HttpService:JSONDecode(body)
                end)

                if decodeSuccess and type(data) == "table" and type(data.data) == "table" then
                    return data, nil
                end
            end

            if statusCode == 429 then
                local retryAfter = getRetryAfterSeconds(response)
                local waitTime = retryAfter or math.min(0.65 * (2 ^ (attempt - 1)), 5)
                waitTime = waitTime + (math.random() * 0.20)
                task.wait(waitTime)
            elseif statusCode and statusCode >= 500 then
                local waitTime = math.min(0.35 * (2 ^ (attempt - 1)), 3)
                waitTime = waitTime + (math.random() * 0.15)
                task.wait(waitTime)
            elseif attempt < HOP_REQUEST_RETRIES then
                task.wait(0.18 * attempt + math.random() * 0.10)
            end
        elseif attempt < HOP_REQUEST_RETRIES then
            task.wait(0.18 * attempt + math.random() * 0.10)
        end
    end

    return nil, "request_failed"
end

local function isUsableServer(server)
    if type(server) ~= "table" then
        return false
    end

    local serverId = server.id
    local playing = server.playing
    local maxPlayers = server.maxPlayers

    if type(serverId) ~= "string" or serverId == "" then
        return false
    end

    if serverId == game.JobId then
        return false
    end

    if type(playing) ~= "number" or type(maxPlayers) ~= "number" then
        return false
    end

    -- Zero-player entries are the most likely to be stale/closing.
    if playing < 1 or playing >= maxPlayers then
        return false
    end

    if isFailedServer(serverId) then
        return false
    end

    return true
end

local function addCandidate(candidateList, seenIds, server)
    if not isUsableServer(server) then
        return false
    end

    if seenIds[server.id] then
        return false
    end

    seenIds[server.id] = true
    table.insert(candidateList, server)
    return true
end

local function scanCandidatePool(req)
    local cursor = nil
    local candidates = {}
    local seenIds = {}
    local pagesRead = 0

    for page = 1, HOP_MAX_PAGES do
        if not alive then
            break
        end

        local data = nil
        local errorReason = nil
        data, errorReason = fetchHopServers(req, cursor)

        if not data then
            if page == 1 then
                return {}, 0, errorReason
            end
            break
        end

        pagesRead = page

        for _, server in ipairs(data.data) do
            addCandidate(candidates, seenIds, server)

            -- V7: no population ranking.
            -- The moment we have a joinable target, stop scanning.
            if #candidates >= 1 then
                return candidates, pagesRead, nil
            end
        end

        local nextCursor = data.nextPageCursor
        if type(nextCursor) ~= "string" or nextCursor == "" then
            break
        end

        cursor = nextCursor
    end

    return candidates, pagesRead, nil
end

local serverHop
local tryNextCandidate

local function queueHopRetry(detailText, delaySeconds)
    if hopRetryQueued or not alive then
        return
    end

    hopRetryQueued = true

    if detailText then
        setStatus("Retrying", detailText, COLORS.Danger)
    end

    task.delay(delaySeconds or HOP_RETRY_DELAY, function()
        hopRetryQueued = false

        if not alive or state.IsHopping or scanningServers then
            return
        end

        if targetIsPresent() then
            serverHop()
        else
            showActiveStatus()
        end
    end)
end

local function clearActivePool()
    activeCandidates = {}
    activeCandidateIndex = 1
end

tryNextCandidate = function()
    if not alive then
        return
    end

    if pendingServerId then
        return
    end

    while activeCandidateIndex <= #activeCandidates do
        local server = activeCandidates[activeCandidateIndex]
        activeCandidateIndex = activeCandidateIndex + 1

        if isUsableServer(server) then
            pendingAttemptId = pendingAttemptId + 1
            local attemptId = pendingAttemptId
            pendingServerId = server.id

            markServerRecent(server.id)

            local playerCount = tonumber(server.playing) or 0
            local ping = tonumber(server.ping)

            if ping then
                setStatus(
                    "Moving",
                    tostring(playerCount) .. " players | " .. tostring(math.floor(ping)) .. " ms",
                    COLORS.Danger
                )
            else
                setStatus(
                    "Moving",
                    tostring(playerCount) .. " players in the next server",
                    COLORS.Danger
                )
            end

            task.wait(0.05)

            if not alive or pendingServerId ~= server.id then
                return
            end

            local teleportSuccess = pcall(function()
                TeleportService:TeleportToPlaceInstance(PLACE_ID, server.id, LocalPlayer)
            end)

            if not teleportSuccess then
                markServerFailed(server.id)

                if pendingServerId == server.id then
                    pendingServerId = nil
                end

                task.defer(tryNextCandidate)
                return
            end

            -- Some executor/Roblox combinations do not reliably surface
            -- TeleportInitFailed. If we are still in the same server after
            -- a long wait, recycle this target and continue the cached pool.
            task.delay(TELEPORT_WATCHDOG_SECONDS, function()
                if not alive then
                    return
                end

                if pendingAttemptId ~= attemptId then
                    return
                end

                if pendingServerId ~= server.id then
                    return
                end

                markServerFailed(server.id)
                pendingServerId = nil
                tryNextCandidate()
            end)

            return
        end
    end

    pendingServerId = nil
    state.IsHopping = false
    clearActivePool()
    queueHopRetry("Refreshing available servers...", 0.55)
end

serverHop = function()
    if state.IsHopping or scanningServers then
        return
    end

    local req = requestFunction()
    if not req then
        setStatus("Unavailable", "HTTP requests are not supported", COLORS.Danger)
        return
    end

    loadServerHistory()
    pruneServerHistory()

    state.IsHopping = true
    scanningServers = true
    pendingServerId = nil
    clearActivePool()

    setStatus("Scanning", "Finding the first available server...", COLORS.Danger)

    task.spawn(function()
        local pool = nil
        local pagesRead = 0
        local errorReason = nil

        pool, pagesRead, errorReason = scanCandidatePool(req)

        scanningServers = false

        if not alive then
            return
        end

        if #pool == 0 then
            state.IsHopping = false
            clearActivePool()

            if errorReason == "request_failed" or pagesRead == 0 then
                queueHopRetry("Server API is busy; backing off...", 1.10)
            else
                queueHopRetry("No available target yet; refreshing...", 0.80)
            end

            return
        end

        activeCandidates = pool
        activeCandidateIndex = 1

        saveServerHistory()
        tryNextCandidate()
    end)
end

connect(TeleportService.TeleportInitFailed, function(player)
    if player ~= LocalPlayer then
        return
    end

    if not state.IsHopping then
        return
    end

    local failedId = pendingServerId
    if not failedId then
        return
    end

    markServerFailed(failedId)
    pendingServerId = nil
    pendingAttemptId = pendingAttemptId + 1

    -- Do NOT re-query immediately. In 1M+ CCU games, the cached pool is much
    -- faster and avoids hammering the public server API during mass joins.
    task.delay(0.08, function()
        if alive and state.IsHopping then
            tryNextCandidate()
        end
    end)
end)

local function checkPlayer(player)
    if state.IsHopping then return end
    if isSelectedPlayer(player) then
        setStatus("Friend detected", player.DisplayName .. " joined this server", COLORS.Danger)
        serverHop()
    end
end

local function checkCurrentPlayers()
    for _, player in ipairs(Players:GetPlayers()) do
        if state.IsHopping then break end
        checkPlayer(player)
    end
end

