local function updateSelectedVisual(choice, persist)
    state.SelectedFriendId = tonumber(choice.Id) or 0
    state.SelectedFriendName = tostring(choice.DisplayName or choice.Username or "All friends")
    state.SelectedUsername = tostring(choice.Username or "all")

    selectedName.Text = state.SelectedFriendName
    selectedUsername.Text = state.SelectedFriendId == 0 and "Monitor everyone" or "@" .. state.SelectedUsername

    if state.SelectedFriendId == 0 then
        avatar.Image = ""
        avatarFallback.Visible = true
    else
        avatarFallback.Visible = false
        local requestedId = state.SelectedFriendId
        local cachedImage = thumbnailCache[requestedId]
        avatar.Image = cachedImage or ""
        if not cachedImage then
            task.spawn(function()
                local success, image = pcall(function()
                    return Players:GetUserThumbnailAsync(
                        requestedId,
                        Enum.ThumbnailType.HeadShot,
                        Enum.ThumbnailSize.Size48x48
                    )
                end)
                if success then thumbnailCache[requestedId] = image end
                if alive and success and state.SelectedFriendId == requestedId then
                    avatar.Image = image
                end
            end)
        end
    end

    if persist then saveConfig() end
    showActiveStatus()
end

