local function tween(instance, duration, properties)
    local previousTween = activeTweens[instance]
    if previousTween then previousTween:Cancel() end

    local tweenInfo = tweenInfoCache[duration]
    if not tweenInfo then
        tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        tweenInfoCache[duration] = tweenInfo
    end

    local nextTween = TweenService:Create(instance, tweenInfo, properties)
    activeTweens[instance] = nextTween
    nextTween:Play()
end

