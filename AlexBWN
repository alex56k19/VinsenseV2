    end
    table.clear(friendRows)

    for index, choice in ipairs(friendChoices) do
        local currentChoice = choice
        local displayName = tostring(currentChoice.DisplayName or currentChoice.Username or "Unknown")
        local username = tostring(currentChoice.Username or "unknown")
        local item = create("TextButton", {
            Size = UDim2.new(1, -2, 0, 37),
            BackgroundColor3 = COLORS.Surface,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Text = "",
            LayoutOrder = index,
            ZIndex = 12,
        }, {corner(7)})
        item.Parent = friendList

        local itemDot = create("Frame", {
            Position = UDim2.fromOffset(9, 14),
            Size = UDim2.fromOffset(8, 8),
            BackgroundColor3 = COLORS.Border,
            BorderSizePixel = 0,
            ZIndex = 13,
        }, {corner(8)})
        itemDot.Parent = item

        local itemName = create("TextLabel", {
            Position = UDim2.fromOffset(26, 4),
            Size = UDim2.new(1, -35, 0, 15),
            BackgroundTransparency = 1,
            Text = displayName,
            Font = Enum.Font.GothamMedium,
            TextSize = 10,
            TextColor3 = COLORS.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 13,
        })
        itemName.Parent = item

        local itemDetail = create("TextLabel", {
            Position = UDim2.fromOffset(26, 19),
            Size = UDim2.new(1, -35, 0, 13),
            BackgroundTransparency = 1,
            Text = currentChoice.Id == 0 and "Monitor every friend" or "@" .. username,
            Font = Enum.Font.Gotham,
            TextSize = 9,
            TextColor3 = COLORS.Muted,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 13,
        })
        itemDetail.Parent = item

        local row = {
            Button = item,
            Dot = itemDot,
            Choice = currentChoice,
            SearchText = string.lower(displayName .. " " .. username),
        }
        table.insert(friendRows, row)

        item.MouseEnter:Connect(function()
            if currentChoice.Id ~= state.SelectedFriendId then
                tween(item, 0.12, {BackgroundColor3 = COLORS.Hover})
            end
        end)
        item.MouseLeave:Connect(function()
            if currentChoice.Id ~= state.SelectedFriendId then
                tween(item, 0.12, {BackgroundColor3 = COLORS.Surface})
            end
        end)
        item.MouseButton1Click:Connect(function()
            selectFriend(currentChoice)
        end)
    end

    rowsDirty = false
    lastRenderedFilter = nil
    lastRenderedSelection = nil
end

local function renderChoices(filterText)
    if rowsDirty then rebuildFriendRows() end

    local filter = string.lower(filterText or "")
    if filter == lastRenderedFilter and state.SelectedFriendId == lastRenderedSelection then return end

    local selectionChanged = state.SelectedFriendId ~= lastRenderedSelection
    local visibleCount = 0

    for _, row in ipairs(friendRows) do
        local matches = filter == "" or string.find(row.SearchText, filter, 1, true) ~= nil
        if row.Button.Visible ~= matches then row.Button.Visible = matches end
        if matches then visibleCount = visibleCount + 1 end

        if selectionChanged then
            local selected = row.Choice.Id == state.SelectedFriendId
            row.Button.BackgroundColor3 = selected and COLORS.AccentDark or COLORS.Surface
            row.Dot.BackgroundColor3 = selected and COLORS.Accent or COLORS.Border
        end
    end

    emptyState.Visible = visibleCount == 0
    lastRenderedFilter = filter
    lastRenderedSelection = state.SelectedFriendId
end

local function loadFriends()
    if loadingFriends then return end
    loadingFriends = true

    task.spawn(function()
        local loaded = {{Id = 0, Username = "all", DisplayName = "All friends"}}
        local success, result = pcall(function()
            local pages = Players:GetFriendsAsync(LocalPlayer.UserId)
            while true do
                for _, friend in ipairs(pages:GetCurrentPage()) do
                    local displayName = friend.DisplayName or friend.Username or "Unknown"
                    table.insert(loaded, {
                        Id = tonumber(friend.Id) or 0,
                        Username = friend.Username or "unknown",
                        DisplayName = displayName,
                        SortKey = string.lower(displayName),
                    })
                end
                if pages.IsFinished then break end
                pages:AdvanceToNextPageAsync()
            end
            return loaded
        end)

        if not alive then return end

        if success then
            table.sort(result, function(a, b)
                if a.Id == 0 then return true end
                if b.Id == 0 then return false end
                return a.SortKey < b.SortKey
            end)
            friendChoices = result
            friendsLoaded = true
            rowsDirty = true

            table.clear(friendIdSet)
            local friendshipExpiry = os.clock() + 300
            for _, choice in ipairs(friendChoices) do
                if choice.Id ~= 0 then
                    friendIdSet[choice.Id] = true
                    friendRelationshipCache[choice.Id] = {
                        Value = true,
                        ExpiresAt = friendshipExpiry,
                    }
                end
            end

            for _, choice in ipairs(friendChoices) do
                if choice.Id == state.SelectedFriendId then
                    updateSelectedVisual(choice, false)
                    break
                end
            end
            task.defer(checkCurrentPlayers)
        else
            friendChoices = loaded
            friendsLoaded = false
            rowsDirty = true
        end

        loadingFriends = false
        if dropdownOpen then renderChoices(searchBox.Text) end
    end)
end

