local function isFriendUserId(userId)
    local now = os.clock()
    local cached = friendRelationshipCache[userId]
    if cached and cached.ExpiresAt > now then
        return cached.Value
    end

    if friendIdSet[userId] then
        friendRelationshipCache[userId] = {Value = true, ExpiresAt = now + 300}
        return true
    end

    local success, isFriend = pcall(function()
        return LocalPlayer:IsFriendsWith(userId)
    end)
    local value = success and isFriend == true
    friendRelationshipCache[userId] = {Value = value, ExpiresAt = now + (value and 300 or 60)}
    return value
end

