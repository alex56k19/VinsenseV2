local cleanup
cleanup = function()
    alive = false
    if runtimeEnvironment.__VinsenseCleanup == cleanup then
        runtimeEnvironment.__VinsenseCleanup = nil
    end
    for _, connection in ipairs(connections) do
        pcall(function() connection:Disconnect() end)
    end
    for _, runningTween in pairs(activeTweens) do
        pcall(function() runningTween:Cancel() end)
    end
    if screenGui.Parent then screenGui:Destroy() end
end
runtimeEnvironment.__VinsenseCleanup = cleanup

